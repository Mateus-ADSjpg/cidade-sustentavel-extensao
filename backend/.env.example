# Copie para .env e preencha. NUNCA versione o .env.
PORT=3001

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave service_role: só no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=

# Token para as rotas administrativas (GET/DELETE /respostas). Gere um valor longo e aleatório.
ADMIN_TOKEN=

# Origens permitidas, separadas por vírgula (ex.: https://seu-site.vercel.app)
CORS_ORIGIN=http://localhost:5173
